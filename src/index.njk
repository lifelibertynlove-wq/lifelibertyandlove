---
layout: layouts/base.njk
permalink: /
---
{# ---- Resolver artículos destacados (con fallback a los más recientes) ---- #}
{% set featuredPosts = [] %}
{% for slug in featured.slugs %}
  {% for p in collections.posts %}
    {% if p.fileSlug == slug %}{% set featuredPosts = (featuredPosts.push(p), featuredPosts) %}{% endif %}
  {% endfor %}
{% endfor %}
{% if featuredPosts.length < 3 %}{% set featuredPosts = collections.posts | limit(5) %}{% endif %}

<section class="carousel" id="carousel" aria-roledescription="carousel" aria-label="Featured posts">
  <div class="carousel-track">
    {% for post in featuredPosts %}
    <article class="slide{% if loop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ featuredPosts.length }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
      {% if post.data.image %}<img class="slide-img" src="{{ post.data.image }}" alt="" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>{% endif %}
      <div class="slide-scrim" aria-hidden="true"></div>
      <div class="slide-content">
        <p class="eyebrow slide-eyebrow">{{ post.data.category }} · {{ post.date | readableDate }}</p>
        <h2 class="slide-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.subtitle %}<p class="slide-sub">{{ post.data.subtitle }}</p>{% endif %}
        <a class="btn btn-solid" href="{{ post.url }}">Read the post</a>
      </div>
    </article>
    {% endfor %}
  </div>
  <button class="carousel-arrow carousel-prev" aria-label="Previous post">&#8249;</button>
  <button class="carousel-arrow carousel-next" aria-label="Next post">&#8250;</button>
  <div class="carousel-dots" role="tablist" aria-label="Choose slide">
    {% for post in featuredPosts %}
    <button class="carousel-dot{% if loop.first %} is-active{% endif %}" role="tab" aria-label="Go to slide {{ loop.index }}"{% if loop.first %} aria-selected="true"{% endif %}></button>
    {% endfor %}
  </div>
</section>

<section class="mission">
  <div class="wrap-narrow">
    <div class="leaf-rule" aria-hidden="true"><span class="rule"></span>{% include "leaf.njk" %}<span class="rule"></span></div>
    <h1 class="mission-title">{{ site.tagline }}</h1>
    <blockquote class="mission-verse">
      <p>&ldquo;{{ site.verse }}&rdquo;</p>
      <cite>{{ site.verseRef }}</cite>
    </blockquote>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title">Latest from the blog</h2>
      <a class="section-link" href="/blog/">All posts →</a>
    </div>
    <div class="card-grid">
      {% for post in collections.posts | limit(3) %}
        {% include "post-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title">Search by topic</h2>
    </div>
    <div class="cat-grid">
      {% for cat in collections.categories %}
      <a class="cat-card" href="/blog/?category={{ cat.slug }}">
        <h3>{{ cat.name }}</h3>
        <span>{{ cat.count }} posts</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap about-teaser">
    <img src="/images/family-photo3.jpg" alt="Carey McNamara with her family" loading="lazy">
    <div>
      <p class="eyebrow">About the author</p>
      <h2 class="section-title">Hi, I'm Carey.</h2>
      <p>I am no theologian, and I have not been to seminary; I am just someone who loves spending time in God's presence, listening for His voice and mining deeper treasure from His Word. Over the years, I have learned that God is not afraid of my questions.</p>
      <p><a href="/about/">Read my story →</a></p>
    </div>
  </div>
</section>

<section class="subscribe-band">
  <div class="wrap-narrow">
    <h2>Will you join me?</h2>
    <p>Enter your email and you won't miss a post.</p>
    <form name="subscribe" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" class="subscribe-form">
      <p class="visually-hidden"><label>Don't fill this out: <input name="bot-field"></label></p>
      <div class="form-row">
        <label class="visually-hidden" for="sub-first">First name</label>
        <input id="sub-first" name="first_name" type="text" placeholder="First name" autocomplete="given-name">
        <label class="visually-hidden" for="sub-email">Email</label>
        <input id="sub-email" name="email" type="email" required placeholder="Email address" autocomplete="email">
        <button type="submit" class="btn btn-light">Subscribe</button>
      </div>
    </form>
  </div>
</section>
