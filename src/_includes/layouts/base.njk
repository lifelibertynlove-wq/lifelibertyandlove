<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ author or site.author }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/png" href="/images/life-liberty-love.png">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' or image %}article{% else %}website{% endif %}">
  {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header{% if heroPage %} site-header--overlay{% endif %}">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/images/life-liberty-love.png" alt="Life, Liberty &amp; Love — home" width="116" height="55">
    </a>
    <nav class="site-nav" aria-label="Main">
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list">
        <span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span><span class="nav-toggle-bar"></span>
        <span class="visually-hidden">Menu</span>
      </button>
      <ul id="nav-list" class="nav-list">
        <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/blog/" {% if '/blog' in page.url or '/item/' in page.url %}aria-current="page"{% endif %}>Blog</a></li>
        <li><a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a></li>
        <li><a href="/contact/" {% if page.url == '/contact/' %}aria-current="page"{% endif %}>Contact</a></li>
        <li><a class="nav-cta" href="/subscribe/">Subscribe</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  {{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="leaf-rule" aria-hidden="true">
      <span class="rule"></span>
      {% include "leaf.njk" %}
      <span class="rule"></span>
    </div>
    <blockquote class="footer-verse">
      <p>&ldquo;{{ site.verse }}&rdquo;</p>
      <cite>{{ site.verseRef }}</cite>
    </blockquote>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a><a href="/blog/">Blog</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/subscribe/">Subscribe</a><a href="/feed.xml">RSS</a>
    </nav>
    <p class="footer-copy">&copy; lifelibertyandlove.com &middot; all rights reserved</p>
  </div>
</footer>

<script>
  // Netlify Identity: los emails de invitación/recuperación apuntan a la raíz
  // del sitio con un token en el hash; lo reenviamos a /admin/, donde vive el widget.
  (function () {
    var h = window.location.hash;
    if (h && /^(#invite_token|#recovery_token|#confirmation_token|#email_change_token)/.test(h) && window.location.pathname.indexOf('/admin') !== 0) {
      window.location.replace('/admin/' + h);
    }
  })();
</script>
<script src="/js/site.js" defer></script>
</body>
</html>
