<article class="post-card" data-category="{{ post.data.category | slugcat }}" data-search="{{ (post.data.title + ' ' + post.data.subtitle + ' ' + post.data.description) | lower }}">
  <a class="post-card-media" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    {% if post.data.image %}<img src="{{ post.data.image }}" alt="" loading="lazy">{% endif %}
  </a>
  <div class="post-card-body">
    <p class="eyebrow">{{ post.data.category }} · {{ post.date | readableDate }}</p>
    <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    {% if post.data.subtitle %}<p class="post-card-sub">{{ post.data.subtitle }}</p>{% endif %}
    <p class="post-card-more"><a href="{{ post.url }}">Read the post<span aria-hidden="true"> →</span></a></p>
  </div>
</article>
